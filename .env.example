# Dummy values only. Never put real secrets in this file.
NUXT_AUTH_API_BASE_URL=http://localhost:3002
NUXT_APP_ORIGIN=http://localhost:3001
NUXT_TELEGRAM_BOT_USERNAME=dummy_bot_username
NUXT_TELEGRAM_MINI_APP_SHORT_NAME=dummy_mini_app_short_name
NUXT_PUBLIC_GOOGLE_CLIENT_ID=dummy_google_client_id
NUXT_PUBLIC_TELEGRAM_CLIENT_ID=dummy_telegram_client_id
NARAKEET_API_KEY=dummy_narakeet_api_key

# One Nuxt/Vercel deployment, explicit product hosts. All rollout gates default off.
NUXT_PUBLIC_DOMAINS_MAIN_ORIGIN=https://chlatwork.com
# JSON origin overrides; tools/payback are reserved and remain inactive.
NUXT_PUBLIC_DOMAINS_PRODUCT_ORIGINS={}
# CSV product names only: creator,link,moment,expense,draw,games,jekluy (no domains or quotes).
# An invalid list disables its migration stage and logs the setting name server-side.
NUXT_PUBLIC_DOMAINS_ENABLED_PRODUCTS=
NUXT_PUBLIC_DOMAINS_CANONICAL_PRODUCTS=
# Requires both enabled and canonical; draw is always excluded to preserve localStorage access.
NUXT_PUBLIC_DOMAINS_REDIRECT_PRODUCTS=
# Optional exact comma-separated preview/staging origins; no wildcard subdomains.
# In Vercel, delete this variable if unused. Do not enter disabled, false, or product names.
NUXT_PUBLIC_DOMAINS_PREVIEW_ORIGINS=
