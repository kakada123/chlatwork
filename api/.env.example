# Dummy local values only. Never commit real provider or JWT secrets.
PORT=3002
FRONTEND_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://chlatwork:local_password@localhost:5432/chlatwork
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
GOOGLE_CLIENT_ID=dummy_google_client_id
GOOGLE_CLIENT_SECRET=dummy_google_client_secret
TELEGRAM_BOT_TOKEN=123456789:dummy_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=dummy_webhook_secret_1234
TELEGRAM_CLIENT_ID=dummy_telegram_client_id
TELEGRAM_CLIENT_SECRET=dummy_telegram_client_secret
# Optional: enables voice-expense transcription and receipt-photo extraction.
OPENAI_API_KEY=dummy_openai_api_key
OPENAI_TELEGRAM_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TELEGRAM_VISION_MODEL=gpt-5-mini

# Creator AI is fail-closed until the API key, models, and provider budgets are configured.
AI_ENABLED=false
CREATOR_PUBLIC_API_BASE_URL=http://localhost:3002
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_PREMIUM_TEXT_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
AI_DAILY_PROVIDER_BUDGET_USD=5
AI_MONTHLY_PROVIDER_BUDGET_USD=100
AI_PROVIDER_ESTIMATED_USD_PER_CREDIT=0.02
AI_INITIAL_CREDITS=20
AI_FREE_RATE_LIMIT_PER_MINUTE=5
AI_FREE_RATE_LIMIT_PER_HOUR=20
AI_FREE_DAILY_CREDIT_LIMIT=10
AI_FREE_MAX_VIDEO_MINUTES=3
AI_FREE_MAX_VIDEO_BYTES=104857600
AI_FREE_MAX_CONCURRENT_VIDEO_JOBS=1
AI_PROVIDER_TIMEOUT_MS=60000
AI_VIDEO_WORKER_POLL_MS=1500
AI_VIDEO_STALE_MINUTES=30
AI_GENERATION_RETENTION_DAYS=30
AI_VIDEO_TEMP_DIR=/tmp/chlatwork-creator
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional Creator Credit price overrides.
AI_CREDIT_PRICE_POST=2
AI_CREDIT_PRICE_SCRIPT=4
AI_CREDIT_PRICE_HOOK=1
AI_CREDIT_PRICE_CONTENT_IDEAS=2
AI_CREDIT_PRICE_KHMER_GRAMMAR=1
AI_CREDIT_PRICE_KHMER_REWRITE=1
AI_CREDIT_PRICE_LATIN_TO_KHMER=1
AI_CREDIT_PRICE_HUMANIZE=1
AI_CREDIT_PRICE_FACEBOOK_TO_TIKTOK=2
AI_CREDIT_PRICE_LONG_TO_SHORT=2
AI_CREDIT_PRICE_VIDEO_CAPTION_PER_MINUTE=3
AI_CREDIT_PRICE_VIDEO_SUMMARY_PER_MINUTE=3
AI_CREDIT_PRICE_VIDEO_TO_SOCIAL_PER_MINUTE=3
AI_CREDIT_PRICE_VIDEO_SUBTITLE_PER_MINUTE=5
AI_CREDIT_PRICE_VIDEO_CONTENT_PACK_PER_MINUTE=7
# Provider pricing is configuration, independent from ChlatWork Credits.
OPENAI_TEXT_INPUT_USD_PER_1M=0
OPENAI_TEXT_OUTPUT_USD_PER_1M=0
OPENAI_PREMIUM_INPUT_USD_PER_1M=0
OPENAI_PREMIUM_OUTPUT_USD_PER_1M=0
OPENAI_TRANSCRIPTION_USD_PER_MINUTE=0
