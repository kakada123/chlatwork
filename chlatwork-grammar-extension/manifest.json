{
  "manifest_version": 3,
  "name": "ChlatWork Grammar Assistant",
  "description": "Fix grammar on websites using your existing ChlatWork AI API, only when you choose to send text.",
  "version": "0.2.0",
  "minimum_chrome_version": "110",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "ChlatWork Grammar - correct text"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "correct-grammar": {
      "suggested_key": { "default": "Alt+Shift+G", "mac": "Alt+Shift+G" },
      "description": "Open ChlatWork grammar assistant for the focused field"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
