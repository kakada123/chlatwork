generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  GOOGLE
  TELEGRAM
}

enum UserRole {
  USER
  ADMIN
}

enum FavoriteKind {
  TOOL
  COMMAND
}

enum ExpenseCurrency {
  USD
  KHR
}

enum ExpenseRangeMode {
  ALL
  MONTH
  WEEK
  TODAY
}

enum BudgetPeriod {
  MONTHLY
  WEEKLY
}

enum ExpenseEntryType {
  EXPENSE
  INCOME
}

enum TelegramBotPendingExpenseStatus {
  PENDING
  CONFIRMED
  CANCELLED
  UNDONE
}

enum PaybackRemainderMode {
  LEFTOVER_ONLY
  ASSIGN_TO_PERSON
}

enum MomentOccasion {
  ANNIVERSARY
  BIRTHDAY
  LOVE
  FRIENDSHIP
  GRADUATION
  WEDDING
  BABY
  MOTHERS_DAY
  FATHERS_DAY
  HOLIDAY
  FAREWELL
  SURPRISE
  INVITATION
  VOTING
  OTHER
}

enum MomentTheme {
  ROMANTIC
  CUTE
  CELEBRATION
  SUNSET
  BOTANICAL
  OCEAN
  MINIMAL
  ELEGANT
}

enum MomentStatus {
  DRAFT
  PUBLISHED
}

enum MomentVisibility {
  UNLISTED
}

enum MomentBlockType {
  HERO
  MESSAGE
  GALLERY
  COUNTER
  SECRET
  EVENT_DETAILS
  LOCATION
  SCHEDULE
  RSVP
  POLL
}

enum MomentRsvpChoice {
  YES
  MAYBE
  NO
}

enum InvitationRecipientType {
  INDIVIDUAL
  COUPLE
  FAMILY
  GROUP
}

enum AiFeature {
  POST
  SCRIPT
  HOOK
  CONTENT_IDEAS
  KHMER_GRAMMAR
  KHMER_REWRITE
  LATIN_TO_KHMER
  HUMANIZE
  FACEBOOK_TO_TIKTOK
  LONG_TO_SHORT
  VIDEO_SUBTITLE
  VIDEO_CAPTION
  VIDEO_SUMMARY
  VIDEO_CONTENT_PACK
  VIDEO_TO_SOCIAL
}

enum AiCreditTransactionType {
  GRANT
  RESERVE
  CHARGE
  REFUND
  PURCHASE
  EXPIRE
  ADMIN_ADJUSTMENT
}

enum AiGenerationStatus {
  RESERVED
  PROCESSING
  COMPLETED
  FAILED
}

enum AiUsageStatus {
  SUCCEEDED
  FAILED
}

enum AiVideoJobStatus {
  QUEUED
  PROCESSING
  TRANSCRIBING
  CLEANING
  GENERATING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String?         @unique
  phone          String?
  name           String?
  avatarUrl      String?
  role           UserRole        @default(USER)
  isActive       Boolean         @default(true)
  telegramNotificationsEnabled Boolean @default(false) @map("telegram_notifications_enabled")
  telegramNotificationsEnabledAt DateTime? @map("telegram_notifications_enabled_at")
  telegramNotificationTimeZone String @default("Asia/Phnom_Penh") @db.VarChar(64) @map("telegram_notification_time_zone")
  telegramDailyExpenseSummaryHour Int @default(22) @map("telegram_daily_expense_summary_hour")
  telegramDailyExpenseSummaryLastAttemptDate DateTime? @db.Date @map("telegram_daily_expense_summary_last_attempt_date")
  telegramBudgetAlertsEnabled Boolean @default(false) @map("telegram_budget_alerts_enabled")
  telegramWeeklyDigestEnabled Boolean @default(false) @map("telegram_weekly_digest_enabled")
  telegramWeeklyDigestHour Int @default(20) @map("telegram_weekly_digest_hour")
  telegramWeeklyDigestLastAttemptDate DateTime? @db.Date @map("telegram_weekly_digest_last_attempt_date")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  socialAccounts SocialAccount[]
  refreshTokens  RefreshToken[]
  expenseProfile ExpenseProfile?
  expenseEntries ExpenseEntry[]
  paybackProfile PaybackProfile?
  paybackEntries PaybackEntry[]
  paybackCalculations PaybackCalculation[]
  toolUsageEvents ToolUsageEvent[]
  favorites       UserFavorite[]
  moments         Moment[]
  telegramBotPendingExpenses TelegramBotPendingExpense[]
  telegramBotConversationState TelegramBotConversationState?
  telegramBudgetAlertState TelegramBudgetAlertState?
  telegramGroupSplits TelegramGroupSplit[]
  aiWallet        AiWallet?
  aiCreditTransactions AiCreditTransaction[]
  aiGenerations   AiGeneration[]
  aiUsageLogs     AiUsageLog[]
  aiVideoJobs     AiVideoJob[]

  @@map("users")
}

model AiWallet {
  userId    String   @id @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_wallets")
}

model AiCreditTransaction {
  id            String                    @id @default(uuid()) @db.Uuid
  userId        String                    @map("user_id") @db.Uuid
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          AiCreditTransactionType
  amount        Int
  feature       AiFeature?
  referenceId   String                    @map("reference_id") @db.VarChar(128)
  balanceBefore Int                       @map("balance_before")
  balanceAfter  Int                       @map("balance_after")
  metadata      Json?
  createdAt     DateTime                  @default(now()) @map("created_at")

  @@unique([userId, type, referenceId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([referenceId])
  @@map("ai_credit_transactions")
}

model AiGeneration {
  id                       String             @id @default(uuid()) @db.Uuid
  userId                   String             @map("user_id") @db.Uuid
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature                  AiFeature
  idempotencyKey           String             @map("idempotency_key") @db.VarChar(128)
  requestHash              String             @map("request_hash") @db.Char(64)
  inputSummary             String?            @map("input_summary") @db.VarChar(160)
  status                   AiGenerationStatus @default(RESERVED)
  creditCost               Int                @map("credit_cost")
  estimatedProviderCostUsd Decimal            @default(0) @map("estimated_provider_cost_usd") @db.Decimal(12, 6)
  result                   Json?
  errorCode                String?            @map("error_code") @db.VarChar(64)
  providerRequestId        String?            @map("provider_request_id") @db.VarChar(128)
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")
  completedAt              DateTime?          @map("completed_at")
  usage                    AiUsageLog?
  videoJob                 AiVideoJob?

  @@unique([userId, feature, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, feature, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("ai_generations")
}

model AiUsageLog {
  id                       String        @id @default(uuid()) @db.Uuid
  generationId             String        @unique @map("generation_id") @db.Uuid
  generation               AiGeneration  @relation(fields: [generationId], references: [id], onDelete: Cascade)
  userId                   String        @map("user_id") @db.Uuid
  user                     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature                  AiFeature
  provider                 String        @db.VarChar(32)
  model                    String        @db.VarChar(80)
  inputTokens              Int?          @map("input_tokens")
  cachedInputTokens        Int?          @map("cached_input_tokens")
  outputTokens             Int?          @map("output_tokens")
  audioSeconds             Int?          @map("audio_seconds")
  creditsCharged           Int           @map("credits_charged")
  estimatedProviderCostUsd Decimal       @default(0) @map("estimated_provider_cost_usd") @db.Decimal(12, 6)
  providerRequestId        String?       @map("provider_request_id") @db.VarChar(128)
  durationMs               Int           @map("duration_ms")
  status                   AiUsageStatus
  errorCode                String?       @map("error_code") @db.VarChar(64)
  createdAt                DateTime      @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([feature, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("ai_usage_logs")
}

model AiVideoJob {
  id             String           @id @default(uuid()) @db.Uuid
  generationId   String           @unique @map("generation_id") @db.Uuid
  generation     AiGeneration     @relation(fields: [generationId], references: [id], onDelete: Cascade)
  userId         String           @map("user_id") @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature        AiFeature
  status         AiVideoJobStatus @default(QUEUED)
  stage          String           @default("QUEUED") @db.VarChar(32)
  originalName   String           @map("original_name") @db.VarChar(180)
  mimeType       String           @map("mime_type") @db.VarChar(64)
  byteSize       BigInt           @map("byte_size")
  durationSeconds Int             @map("duration_seconds")
  tempFilePath   String?          @map("temp_file_path") @db.VarChar(500)
  attempts       Int              @default(0)
  errorCode      String?          @map("error_code") @db.VarChar(64)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  startedAt      DateTime?        @map("started_at")
  completedAt    DateTime?        @map("completed_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([status, createdAt])
  @@map("ai_video_jobs")
}

model Moment {
  id            String           @id @default(uuid()) @db.Uuid
  slug          String           @unique @db.VarChar(96)
  creatorId     String           @map("creator_id") @db.Uuid
  creator       User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  recipientName String           @map("recipient_name") @db.VarChar(80)
  occasion      MomentOccasion
  title         String           @db.VarChar(120)
  theme         MomentTheme
  status        MomentStatus     @default(DRAFT)
  visibility    MomentVisibility @default(UNLISTED)
  publishAt     DateTime?        @map("publish_at")
  expiresAt     DateTime?        @map("expires_at")
  publishedAt   DateTime?        @map("published_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  blocks        MomentBlock[]
  media         MomentMedia[]
  rsvps         MomentRsvp[]
  invitationGuests MomentInvitationGuest[]
  votes           MomentVote[]
  voteSchedule    MomentVoteSchedule?

  @@index([creatorId, status, createdAt(sort: Desc)])
  @@index([status, publishAt])
  @@map("moments")
}

model MomentVote {
  id          String   @id @default(uuid()) @db.Uuid
  momentId    String   @map("moment_id") @db.Uuid
  moment      Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  responseKey String   @map("response_key") @db.Char(64)
  optionId    String   @map("option_id") @db.VarChar(40)
  voterName   String?  @map("voter_name") @db.VarChar(80)
  voteDate    DateTime @default(dbgenerated("'1970-01-01'::date")) @map("vote_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([momentId, responseKey, voteDate])
  @@index([momentId, voteDate, optionId])
  @@map("moment_votes")
}

model MomentVoteSchedule {
  id                  String   @id @default(uuid()) @db.Uuid
  momentId            String   @unique @map("moment_id") @db.Uuid
  moment              Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  telegramChatId      BigInt   @unique @map("telegram_chat_id")
  telegramChatTitle   String?  @map("telegram_chat_title") @db.VarChar(120)
  timeZone            String   @default("Asia/Phnom_Penh") @map("time_zone") @db.VarChar(64)
  sendHour            Int      @default(10) @map("send_hour")
  sendMinute          Int      @default(0) @map("send_minute")
  enabled             Boolean  @default(true)
  lastAttemptDate     DateTime? @map("last_attempt_date") @db.Date
  lastSentAt          DateTime? @map("last_sent_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([enabled, sendHour, sendMinute])
  @@map("moment_vote_schedules")
}

model MomentRsvp {
  id            String           @id @default(uuid()) @db.Uuid
  momentId      String           @map("moment_id") @db.Uuid
  moment        Moment           @relation(fields: [momentId], references: [id], onDelete: Cascade)
  responseKey   String           @map("response_key") @db.Char(64)
  guestId       String?          @unique @map("guest_id") @db.Uuid
  guest         MomentInvitationGuest? @relation(fields: [guestId], references: [id], onDelete: Cascade)
  choice        MomentRsvpChoice
  guestName     String?          @map("guest_name") @db.VarChar(80)
  guestCount    Int              @default(1) @map("guest_count")
  note          String?          @db.VarChar(500)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@unique([momentId, responseKey])
  @@index([momentId, choice])
  @@map("moment_rsvps")
}

model MomentInvitationGuest {
  id            String                  @id @default(uuid()) @db.Uuid
  momentId      String                  @map("moment_id") @db.Uuid
  moment        Moment                  @relation(fields: [momentId], references: [id], onDelete: Cascade)
  token         String                  @unique @db.VarChar(32)
  displayName   String                  @map("display_name") @db.VarChar(120)
  recipientType InvitationRecipientType @default(INDIVIDUAL) @map("recipient_type")
  maxGuests     Int                     @default(1) @map("max_guests")
  sentAt        DateTime?               @map("sent_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  rsvp          MomentRsvp?

  @@index([momentId, createdAt])
  @@map("moment_invitation_guests")
}

model MomentBlock {
  id        String          @id @default(uuid()) @db.Uuid
  momentId  String          @map("moment_id") @db.Uuid
  moment    Moment          @relation(fields: [momentId], references: [id], onDelete: Cascade)
  type      MomentBlockType
  position  Int
  data      Json
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([momentId, position])
  @@map("moment_blocks")
}

model MomentMedia {
  id           String   @id @default(uuid()) @db.Uuid
  momentId     String   @map("moment_id") @db.Uuid
  moment       Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  position     Int
  mimeType     String   @map("mime_type") @db.VarChar(32)
  byteSize     Int      @map("byte_size")
  originalName String   @map("original_name") @db.VarChar(180)
  storageKey   String?  @map("storage_key") @db.VarChar(500)
  content      Bytes?
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([momentId, position])
  @@map("moment_media")
}

model ToolUsageEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolKey   String   @db.VarChar(100)
  event     String   @db.VarChar(20)
  createdAt DateTime @default(now())

  @@index([userId, toolKey, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("tool_usage_events")
}

model UserFavorite {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      FavoriteKind
  itemKey   String       @db.VarChar(100)
  createdAt DateTime     @default(now())

  @@unique([userId, kind, itemKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("user_favorites")
}

model PaybackProfile {
  userId          String               @id @db.Uuid
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency        ExpenseCurrency      @default(USD)
  remainderMode   PaybackRemainderMode @default(LEFTOVER_ONLY)
  remainderPayer  String               @default("") @db.VarChar(120)
  rawInput        String               @default("")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("payback_profiles")
}

model PaybackEntry {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position    Int
  name        String   @db.VarChar(120)
  amount      Decimal? @db.Decimal(20, 2)
  amountInput String   @default("") @db.VarChar(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, position])
  @@map("payback_entries")
}

model PaybackCalculation {
  id              String                       @id @default(uuid()) @db.Uuid
  userId          String                       @db.Uuid
  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency        ExpenseCurrency
  remainderMode   PaybackRemainderMode
  remainderPayer  String                       @default("") @db.VarChar(120)
  total           Decimal                      @db.Decimal(20, 2)
  participantCount Int
  createdAt       DateTime                     @default(now())
  entries         PaybackCalculationEntry[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("payback_calculations")
}

model PaybackCalculationEntry {
  id            String             @id @default(uuid()) @db.Uuid
  calculationId String             @db.Uuid
  calculation   PaybackCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  position      Int
  name          String             @db.VarChar(120)
  amount        Decimal            @db.Decimal(20, 2)
  amountInput   String             @db.VarChar(64)

  @@unique([calculationId, position])
  @@map("payback_calculation_entries")
}

model ExpenseProfile {
  userId              String           @id @db.Uuid
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency            ExpenseCurrency  @default(USD)
  rangeMode           ExpenseRangeMode @default(MONTH)
  budgetPeriod        BudgetPeriod     @default(MONTHLY)
  budgetInput         String           @default("") @db.VarChar(64)
  rawInput            String           @default("")
  quickExpenseEnabled Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("expense_profiles")
}

model ExpenseEntry {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  position       Int
  type           ExpenseEntryType
  entryDate      DateTime?        @db.Date
  category       String           @db.VarChar(120)
  customCategory String?          @db.VarChar(120)
  note           String           @db.VarChar(500)
  showNote       Boolean          @default(false)
  amount         Decimal?         @db.Decimal(20, 2)
  amountInput    String           @default("") @db.VarChar(64)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  telegramBotPendingExpense TelegramBotPendingExpense?

  @@unique([userId, position])
  @@index([userId, entryDate])
  @@map("expense_entries")
}

model TelegramBotUpdate {
  updateId    BigInt    @id @map("update_id")
  receivedAt DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@index([receivedAt])
  @@map("telegram_bot_updates")
}

model TelegramBotPendingExpense {
  id              String                          @id @default(uuid()) @db.Uuid
  userId          String                          @map("user_id") @db.Uuid
  user            User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramUserId  String                          @map("telegram_user_id") @db.VarChar(20)
  chatId          BigInt                          @map("chat_id")
  sourceMessageId BigInt                          @map("source_message_id")
  amountInput     String                          @map("amount_input") @db.VarChar(64)
  currency        ExpenseCurrency
  category        String                          @db.VarChar(120)
  note            String                          @db.VarChar(500)
  entryDate       DateTime                        @map("entry_date") @db.Date
  status          TelegramBotPendingExpenseStatus @default(PENDING)
  expenseEntryId  String?                         @unique @map("expense_entry_id") @db.Uuid
  expenseEntry    ExpenseEntry?                   @relation(fields: [expenseEntryId], references: [id], onDelete: SetNull)
  editTargetExpenseEntryId String?                 @map("edit_target_expense_entry_id") @db.Uuid
  expiresAt       DateTime                        @map("expires_at")
  confirmedAt     DateTime?                       @map("confirmed_at")
  createdAt       DateTime                        @default(now()) @map("created_at")
  updatedAt       DateTime                        @updatedAt @map("updated_at")

  @@unique([chatId, sourceMessageId])
  @@index([userId])
  @@index([editTargetExpenseEntryId])
  @@index([telegramUserId, status, expiresAt])
  @@map("telegram_bot_pending_expenses")
}

model TelegramBotConversationState {
  telegramUserId          String   @id @map("telegram_user_id") @db.VarChar(20)
  userId                  String   @unique @map("user_id") @db.Uuid
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId                  BigInt   @map("chat_id")
  editTargetExpenseEntryId String  @map("edit_target_expense_entry_id") @db.Uuid
  expiresAt               DateTime @map("expires_at")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("telegram_bot_conversation_states")
}

model TelegramBudgetAlertState {
  userId        String   @id @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodKey     String   @map("period_key") @db.VarChar(32)
  lastThreshold Int      @map("last_threshold")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("telegram_budget_alert_states")
}

model TelegramGroupSplit {
  id              String   @id @default(uuid()) @db.Uuid
  creatorUserId   String   @map("creator_user_id") @db.Uuid
  creator         User     @relation(fields: [creatorUserId], references: [id], onDelete: Cascade)
  telegramChatId  BigInt   @map("telegram_chat_id")
  title           String   @default("Shared expense") @db.VarChar(120)
  total           Decimal  @db.Decimal(20, 2)
  currency        ExpenseCurrency
  status          String   @default("OPEN") @db.VarChar(16)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  participants    TelegramGroupSplitParticipant[]

  @@index([telegramChatId, status, createdAt(sort: Desc)])
  @@index([creatorUserId, createdAt(sort: Desc)])
  @@map("telegram_group_splits")
}

model TelegramGroupSplitParticipant {
  id                  String   @id @default(uuid()) @db.Uuid
  splitId             String   @map("split_id") @db.Uuid
  split               TelegramGroupSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  position            Int
  name                String   @db.VarChar(80)
  amount              Decimal  @db.Decimal(20, 2)
  telegramUserId      String?  @map("telegram_user_id") @db.VarChar(20)
  telegramDisplayName String?  @map("telegram_display_name") @db.VarChar(80)
  paidAt              DateTime? @map("paid_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([splitId, position])
  @@unique([splitId, telegramUserId])
  @@index([splitId, paidAt])
  @@map("telegram_group_split_participants")
}

model SocialAccount {
  id              String       @id @default(uuid()) @db.Uuid
  provider        AuthProvider
  providerUserId  String
  providerEmail   String?
  userId          String       @db.Uuid
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_accounts")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
