# Dummy local values only. Never commit real provider or JWT secrets.
PORT=3002
FRONTEND_ORIGIN=http://localhost:3001
# YouTube downloader: enable only after its runtime dependencies and public origin are configured.
YOUTUBE_DOWNLOADER_ENABLED=false
YOUTUBE_DOWNLOADER_PUBLIC_BASE_URL=http://localhost:3002
YOUTUBE_DOWNLOADER_YTDLP_PATH=yt-dlp
# Optional application-owned temporary root; blank uses the operating system temporary directory.
YOUTUBE_DOWNLOADER_TEMP_DIR=
DATABASE_URL=postgresql://chlatwork:local_password@localhost:5432/chlatwork
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
GOOGLE_CLIENT_ID=dummy_google_client_id
GOOGLE_CLIENT_SECRET=dummy_google_client_secret
TELEGRAM_BOT_TOKEN=123456789:dummy_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=dummy_webhook_secret_1234
# Business inbox scanning and deletion are opt-in. Configure AI and/or a real scanner at runtime.
TELEGRAM_BUSINESS_SECURITY_ENABLED=false
TELEGRAM_BUSINESS_SECURITY_AUTO_DELETE=false
TELEGRAM_BUSINESS_SECURITY_OWNER_ALERTS=true
TELEGRAM_BUSINESS_SECURITY_CHAT_ALERTS=true
TELEGRAM_BUSINESS_SECURITY_RISK_THRESHOLD=90
TELEGRAM_BUSINESS_SECURITY_CONFIDENCE_THRESHOLD=95
# AI warnings are separate from automatic deletion and require a supported risk category.
TELEGRAM_BUSINESS_SECURITY_WARNING_RISK_THRESHOLD=50
TELEGRAM_BUSINESS_SECURITY_WARNING_CONFIDENCE_THRESHOLD=60
# Per API process; messages above this rate stay untouched.
TELEGRAM_BUSINESS_SECURITY_MAX_SCANS_PER_MINUTE=60
# Optional real document malware scanning via a private ClamD service.
TELEGRAM_BUSINESS_FILE_SCAN_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
# Default 10 MiB, maximum 20 MiB; downloads above this limit are cancelled.
TELEGRAM_BUSINESS_FILE_SCAN_MAX_BYTES=10485760
TELEGRAM_BUSINESS_FILE_SCAN_MAX_CONCURRENT=2
# Optional Google Web Risk Lookup: sends public URLs to Google, never visits them.
TELEGRAM_BUSINESS_URL_SCAN_ENABLED=false
WEBRISK_API_KEY=dummy_webrisk_api_key
WEBRISK_TIMEOUT_MS=5000
TELEGRAM_BUSINESS_URL_SCAN_MAX_LINKS=5
TELEGRAM_BUSINESS_URL_SCAN_MAX_CONCURRENT=2
# Per API process; also configure a project-wide quota in Google Cloud.
TELEGRAM_BUSINESS_URL_SCAN_MAX_REQUESTS_PER_MINUTE=60
# Optional separate Khmer AI & Creator bot. Leave both empty to disable it.
CREATOR_TELEGRAM_BOT_TOKEN=
CREATOR_TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CLIENT_ID=dummy_telegram_client_id
TELEGRAM_CLIENT_SECRET=dummy_telegram_client_secret
# Set AI_USE_GEMINI=true to use Gemini for Creator (web and Telegram) and the
# expense/personal-assistant Telegram bot. false keeps every AI call on OpenAI.
AI_USE_GEMINI=false
# Required only when AI_USE_GEMINI=false and AI features are enabled.
OPENAI_API_KEY=dummy_openai_api_key

# Creator AI is fail-closed until the selected provider and budgets are configured.
AI_ENABLED=false
OPENAI_TEXT_MODEL=gpt-5-mini
# Creator subtitles require segment timestamps, supported by whisper-1.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
AI_DAILY_PROVIDER_BUDGET_USD=5
AI_MONTHLY_PROVIDER_BUDGET_USD=100

# Creator product defaults and Telegram AI model defaults live in code. Add an
# override only when an operational or pricing change needs it.

# Required when AI_USE_GEMINI=true. Replace dummy values only in runtime settings.
GEMINI_API_KEY=dummy_gemini_api_key
# Gemini defaults use 3.5 Flash-Lite for text/vision and 3.5 Transcribe for audio.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Optional; defaults to GEMINI_TEXT_MODEL for premium Creator prompts.
# GEMINI_PREMIUM_TEXT_MODEL=gemini-3.5-flash-lite
# Optional Telegram overrides; both default to GEMINI_TEXT_MODEL.
# GEMINI_TELEGRAM_ASSISTANT_MODEL=gemini-3.5-flash-lite
# GEMINI_TELEGRAM_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
# Current published estimates; review pricing when changing models.
GEMINI_TEXT_INPUT_USD_PER_1M=0.30
GEMINI_TEXT_OUTPUT_USD_PER_1M=2.50
GEMINI_TRANSCRIPTION_USD_PER_MINUTE=0.005
# Set both premium rates when using a different premium model.
# GEMINI_PREMIUM_INPUT_USD_PER_1M=1.25
# GEMINI_PREMIUM_OUTPUT_USD_PER_1M=10
