# Opt-in Railway recipe. Build context must be api/, not the repository root.
FROM node:22.22.1-bookworm-slim AS media
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv ffmpeg ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

FROM media AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev
COPY requirements-youtube-downloader.txt ./
RUN python3 -m venv /opt/youtube \
    && /opt/youtube/bin/pip install --no-cache-dir -r requirements-youtube-downloader.txt \
    && /opt/youtube/bin/python -c "import yt_dlp, yt_dlp_ejs" \
    && /opt/youtube/bin/yt-dlp --ignore-config --version \
    && ffmpeg -version && ffprobe -version

FROM media AS runtime
ENV NODE_ENV=production
ENV PATH="/opt/youtube/bin:${PATH}"
ENV YOUTUBE_DOWNLOADER_ENABLED=false
WORKDIR /app
COPY --from=build /opt/youtube /opt/youtube
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/package.json ./package.json
USER node
EXPOSE 3002
CMD ["node", "dist/main.js"]
